{
  "openapi": "3.0.3",
  "info": {
    "title": "momo. Anime Catalog API",
    "version": "1.0.0",
    "description": "JSON API каталога аниме. Данные хранятся в PostgreSQL."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Проверить API и базу данных",
        "responses": {
          "200": {
            "description": "API и PostgreSQL доступны",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Получить аниме",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Поиск по названию и описанию",
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Точное название жанра",
            "schema": { "type": "string" }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["newest", "price_asc", "price_desc", "title"],
              "default": "newest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список аниме",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "summary": "Добавить аниме",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewProduct" },
              "example": {
                "title": "Новое аниме",
                "description": "Краткое описание сюжета",
                "image": "https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx130003-HTDmeL4RGeJ4.png",
                "price": 299,
                "category": "Музыка"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Аниме добавлено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/products/{id}": {
      "delete": {
        "summary": "Удалить аниме",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Аниме удалено" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/categories": {
      "get": {
        "summary": "Получить жанры",
        "responses": {
          "200": {
            "description": "Жанры, доступные в базе данных",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewProduct": {
        "type": "object",
        "required": ["title", "description", "image", "price", "category"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 2000 },
          "image": { "type": "string", "format": "uri", "description": "Прямая ссылка на изображение по HTTP(S)" },
          "price": { "type": "number", "minimum": 0.01, "multipleOf": 0.01 },
          "category": { "type": "string", "maxLength": 80 }
        }
      },
      "Product": {
        "allOf": [
          { "$ref": "#/components/schemas/NewProduct" },
          {
            "type": "object",
            "required": ["id", "created_at"],
            "properties": {
              "id": { "type": "integer", "format": "int64" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Некорректный запрос",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Аниме не найдено",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "ServerError": {
        "description": "Ошибка сервера",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
